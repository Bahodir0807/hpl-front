# Server-only Nest API origin used by Next.js BFF routes
# (/api/auth/*, /api/backend/*). The browser must keep calling /api/backend.
API_URL=http://localhost:3001/api

# Optional fallback for getBackendApiUrl() if API_URL is unset.
# Also interpolated into Content-Security-Policy connect-src.
# Prefixed NEXT_PUBLIC_ so it is visible to the client bundle — do not put secrets here.
# Browser axios still uses /api/backend, not this URL.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional public app origin (SSR absolute links). Currently unused by source.
NEXT_PUBLIC_APP_URL=http://localhost:3000
